<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Car</title>
</head>
<body>
    <h1>Edit Car</h1>

    <br>
    
    <form action="/cars/<%= car._id %>?_method=PUT" method="POST">
        <label for="brand">Brand:</label>
        <input type="text" id="brand" name="brand" value="<%= car.brand %>" required/>

        <label for="model">Model:</label>
        <input type="text" id="model" name="model" value="<%= car.model %>" required/>


        <label for="year">Year:</label>
        <input type="Number" id="year" name="year" value="<%= car.year %>" required/>


        <label for="isElectric">Is Electric?</label>
        <input type="checkbox" id="isElectric" name="isElectric" value="<%= car.isElectric ? 'checked' %>"/>

        <button type="submit">Create Car</button>
        </form>


        <a href="/cars/<%= car._id %>">Cancel</a>
</body>
</html>