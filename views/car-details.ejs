<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= car.brand %>
            <%= car.model %>
    </title>
</head>

<body>
    <h1>
        <%= car.brand %> - <%= car.model %>
    </h1>
    <p>Year: <%= car.year %>
    </p>
    <p>Is Electric: <%= car.isElectric ? 'Yes' : 'No' %>
    </p>

    <a href="/cars/<%= car._id %>/edit">Edit Cars</a>

    <form action="/cars/<%= car.id %>?_method=DELETE" method="POST">
        <button TYPE="submit">Delete Cars</button>
    </form>


</body>

</html>