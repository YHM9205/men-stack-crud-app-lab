<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Cars</title>
</head>

<body>
    <h1>All Cars</h1>

    <br>

    <a href="/cars/new">Add New Car</a>
    <ul>
        <% cars.forEach(car=> { %>
            <li>
                <a href="/cars/<%= car._id %>">
                    <%= car.brand %> - <%= car.model %> (<%= car.year %>)
                </a>
            </li>
            <% }); %>
    </ul>


    <a href="/">Home</a>
</body>

</html>